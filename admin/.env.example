VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Vercel serverless function — paste the full JSON from Firebase Console
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Eventbrite API — get your private token from https://www.eventbrite.com/platform/api-keys
# Used by /api/eventbrite to pull Zimbabwe-related events into the admin review queue
EVENTBRITE_API_KEY=your-eventbrite-private-token
