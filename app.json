{
  "expo": {
    "name": "HomeQuarters",
    "slug": "homequarters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "homequarters",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homequarters.app",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSCameraUsageDescription": "HomeQuarters uses your camera to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "HomeQuarters accesses your photo library so you can set a profile photo.",
        "NSUserNotificationUsageDescription": "HomeQuarters sends notifications for connection requests, event reminders, and membership updates.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.homequarters.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "react-native-maps",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc080307-b9fa-4c60-b376-dd42ec09f31b"
      }
    },
    "owner": "the-home-quarters"
  }
}
