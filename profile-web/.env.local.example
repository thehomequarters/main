# Firebase Admin SDK — service account key JSON (minified, no newlines)
# Generate from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Root domain for subdomain extraction in middleware
ROOT_DOMAIN=thehomequarters.com

# Resend API key — used by /api/webApplication and /api/subscribe
# Get from resend.com → API Keys
RESEND_API_KEY=re_...
